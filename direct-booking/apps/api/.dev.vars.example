# Copy to .dev.vars (gitignored) for `wrangler dev`. Test-mode values only, never live keys.
# Each becomes a Worker secret in production (`wrangler secret put NAME`), except DEV_ORIGINS.
# `npm run types` reads this file for the Env type, so keep every name listed here.

# Guest site origins allowed to call the API during development (comma-separated).
DEV_ORIGINS=http://localhost:3000
# Secret behind each property's iCal export URL (any long random string).
ICAL_EXPORT_TOKEN=dev-export-token
# Where nightly rates come from: "fixture" (made-up rates, development only) or "pricelabs".
PRICE_SOURCE=fixture
# TODO(host): PriceLabs API key (and endpoint details for the client in src/prices.ts).
PRICELABS_API_KEY=
